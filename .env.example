# Supabase (safe to expose in the Vite client)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# API.Bible — server only. Never prefix with VITE_.
# Used by /api/bible (Vercel serverless + Vite dev middleware).
API_BIBLE_KEY=your-api-bible-key
# BIBLE_API_KEY is also accepted as an alias.
